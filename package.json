{
  "name": "optimle",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "validate": "pnpm --filter @wordle/pipeline validate",
    "data": "pnpm --filter @wordle/pipeline generate",
    "dev": "pnpm --filter @wordle/site dev",
    "build": "pnpm --filter @wordle/site build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
